  "changes": [
    {
      "record_id": "UNDER_ATTACK7",
      "before": "...놈들은 중력 우물 근처에서 싸우길 좋아해.\n빗나간 탄환이 우리 행성 표면에 자꾸 떨어져서\n종종 비극을 일으키지.",
      "after": "...놈들은 강한 중력 우물 근처에서 싸우길 좋아해.\n빗나간 탄환이 우리 행성 표면에 자꾸 떨어져서\n종종 비극을 일으키지.",
      "reason": "strong gravity wells의 강도 수식어를 복원한다."
    },
    {
      "record_id": "EMMISSARIES6",
      "before": "알파 투카나이라는 항성으로 가세요.\n태양에 가장 가까운 행성이 우리 고향이에요.",
      "after": "알파 투카나이라는 항성으로 가세요.\n그 항성에 가장 가까운 행성이 우리 고향이에요.",
      "reason": "알파 투카나이를 가리키는 sun을 지구 태양과 혼동하지 않게 한다."
    },
    {
      "record_id": "GENERAL_INFO_43",
      "before": "아, 그래! 그때 기억해?\n고장 난 시계를 고칠 수 있다면서\n'정신 공명 파동'인가 뭔가를 쓴다고 했잖아?\n내가 보기엔 '꼴불견 파동'이던데!\n냐르크! 냐르크! 냐르크!",
      "after": "아, 그래! 그때 기억해?\n고장 난 시계를 고칠 수 있다면서\n'정신 공명 파동'인가 뭔가를 쓴다고 했잖아?\n내가 보기엔 '정신 나간 파동'이던데!\n냐르크! 냐르크! 냐르크!",
      "reason": "sympathetic/pathetic의 말장난을 앞선 정신 공명 파동을 비트는 표현으로 옮긴다."
    },
    {
      "record_id": "GENERAL_INFO_48",
      "before": "아주 무례하게 끼어들기 전에 하던 말씀을 계속하자면!...",
      "after": "누가 아주 무례하게 말을 끊기 전에 하던 말씀을 계속하자면!...",
      "reason": "조크가 끼어든 것이 아니라 피크에게 말을 끊겼다는 주체 관계를 명확히 한다."
    }
  ],
